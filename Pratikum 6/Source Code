# ----------------------------------------------------------
# 1. KELAS STRUKTUR ATURAN FUZZY
# ----------------------------------------------------------
class FuzzyRule:
def __init__(self, rule_id, antecedent, consequent, operator='AND'):
"""
antecedent: dict {'nama_variabel': 'nama_label'}
consequent: dict {'nama_variabel': 'nama_label'}
"""
self.rule_id = rule_id
self.antecedent = antecedent
self.consequent = consequent
self.operator = operator.upper()
def hitung_firing_strength(self, derajat_fuzzifikasi):
nilai_derajat = []
for var_nama, label_nama in self.antecedent.items():
deg = derajat_fuzzifikasi[var_nama].get(label_nama, 0.0)
nilai_derajat.append(deg)
if not nilai_derajat:
return 0.0
if self.operator == 'AND':
return min(nilai_derajat)
elif self.operator == 'OR':
return max(nilai_derajat)
else:
raise ValueError(f"Operator {self.operator} tidak dikenali.")
def __str__(self):
syarat = f" {self.operator} ".join(
[f"{var} is {lbl}" for var, lbl in self.antecedent.items()])
hasil = ", ".join(
[f"{var} is {lbl}" for var, lbl in self.consequent.items()])
return f"[{self.rule_id}] IF {syarat} THEN {hasil}"

# ----------------------------------------------------------
# 2. BASIS ATURAN (RULE BASE) - 3 x 3 = 9 ATURAN
#
# Matriks aturan (Suhu \ Beban CPU -> Kecepatan Kipas):
# | Ringan | Sedang | Berat
# Dingin | Lambat | Lambat | Sedang
# Normal | Lambat | Sedang | Cepat
# Panas | Sedang | Cepat | Cepat
# ----------------------------------------------------------
rule_base = [
FuzzyRule("R1", {"suhu": "Dingin", "beban": "Ringan"}, {"kipas": "Lambat"}),
FuzzyRule("R2", {"suhu": "Dingin", "beban": "Sedang"}, {"kipas": "Lambat"}),
FuzzyRule("R3", {"suhu": "Dingin", "beban": "Berat"}, {"kipas": "Sedang"}),
FuzzyRule("R4", {"suhu": "Normal", "beban": "Ringan"}, {"kipas": "Lambat"}),
FuzzyRule("R5", {"suhu": "Normal", "beban": "Sedang"}, {"kipas": "Sedang"}),
FuzzyRule("R6", {"suhu": "Normal", "beban": "Berat"}, {"kipas": "Cepat"}),
FuzzyRule("R7", {"suhu": "Panas", "beban": "Ringan"}, {"kipas": "Sedang"}),
FuzzyRule("R8", {"suhu": "Panas", "beban": "Sedang"}, {"kipas": "Cepat"}),
FuzzyRule("R9", {"suhu": "Panas", "beban": "Berat"}, {"kipas": "Cepat"}),
]
# ----------------------------------------------------------
# 3. EVALUASI ATURAN TERHADAP DATA INPUT
# ----------------------------------------------------------
derajat_input = {
"suhu": {"Dingin": 0.2, "Normal": 0.8, "Panas": 0.0},
"beban": {"Ringan": 0.0, "Sedang": 0.5, "Berat": 0.5},
}
print("=" * 75)
print("HASIL EVALUASI BASIS ATURAN FUZZY - KIPAS PENDINGIN SERVER")
print("=" * 75)
aturan_aktif = []
for rule in rule_base:
alpha = rule.hitung_firing_strength(derajat_input)
out_var = list(rule.consequent.keys())[0]
out_lbl = rule.consequent[out_var]
status = f"AKTIF (alpha = {alpha:.2f})" if alpha > 0 else "NONAKTIF"
print(f"{rule} --> {status}")
if alpha > 0:
aturan_aktif.append((rule.rule_id, out_lbl, alpha))
print("\n" + "=" * 75)
print("RINGKASAN ATURAN YANG TERPICU (FIRING RULES):")
print("=" * 75)
for r_id, konklusi, alpha in aturan_aktif:
print(f" - {r_id:<4} : Kecepatan Kipas = {konklusi:<8} dengan alpha = {alpha:.2f}")
# ----------------------------------------------------------
# 4. (BONUS) AGREGASI ALPHA PER LABEL OUTPUT DENGAN OPERATOR MAX
# ----------------------------------------------------------
agregasi = {}
for _, lbl, alpha in aturan_aktif:
agregasi[lbl] = max(agregasi.get(lbl, 0.0), alpha)
print("\n" + "=" * 75)
print("AGREGASI PER LABEL OUTPUT (MAX):")
print("=" * 75)
for lbl, a in agregasi.items():
print(f" - Kecepatan Kipas = {lbl:<8} : alpha agregat = {a:.2f}")
